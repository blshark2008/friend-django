# ============================================================================
# Конфигурация SIEM-агента
# ============================================================================
# Скопируйте этот файл в /opt/siem/config.env и заполните параметры.
# ============================================================================

# URL Django-сервера SIEM
SIEM_SERVER="https://127.0.0.1:8000"

# Токен авторизации (создаётся командой: python manage.py drf_create_token <user>)
SIEM_TOKEN="your-token-here"
